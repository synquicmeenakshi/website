{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    { "source": "/contact", "destination": "/book", "permanent": true },
    { "source": "/services/universe", "destination": "/#universe", "permanent": true },
    { "source": "/testimonials", "destination": "/#testimonials", "permanent": true },
    { "source": "/faq", "destination": "/#faq", "permanent": true }
  ],

  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },

    { "source": "/services/astrology", "destination": "/index.html" },
    { "source": "/services/numerology", "destination": "/index.html" },
    { "source": "/services/vastu-shastra", "destination": "/index.html" },
    { "source": "/services/rune-card-reading", "destination": "/index.html" },
    { "source": "/services/karma-alignment", "destination": "/index.html" },
    { "source": "/services/swar-vigyan", "destination": "/index.html" },
    { "source": "/services/spiritual-remedies", "destination": "/index.html" },
    { "source": "/services/graphology", "destination": "/index.html" },

    { "source": "/journey", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },

    { "source": "/legal/privacy-policy", "destination": "/index.html" },
    { "source": "/legal/terms-and-conditions", "destination": "/index.html" },
    { "source": "/legal/refund-policy", "destination": "/index.html" },
    { "source": "/legal/code-of-ethics", "destination": "/index.html" },
    { "source": "/legal/disclaimer", "destination": "/index.html" },

    { "source": "/((?!assets/|img/|favicon|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
